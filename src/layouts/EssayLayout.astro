---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { PILLAR_LABELS, formatDate, type Essay } from "../lib/essays";

interface Props {
  essay: Essay;
}
const { essay } = Astro.props;
const { title, description, pubDate, ogImage } = essay.data;
---

<Layout
  title={`${title} - Kigumi`}
  description={description}
  ogType="article"
  ogImage={ogImage}
  publishedTime={pubDate.toISOString()}
>
  <Nav active="writing" />

  <article class="essay">
    <div class="container">
      <div class="essay__inner">
        <div class="essay__back">
          <a href="/lab/harness/writing" class="back-link">&larr; All writing</a>
        </div>
        <div class="essay__meta">
          <span class="essay__pillar">{PILLAR_LABELS[essay.data.pillar]}</span>
          <span class="essay__date">{formatDate(pubDate)}</span>
        </div>
        <h1 class="essay__title">{title}</h1>
        <p class="essay__standfirst">{description}</p>
      </div>

      <div class="essay__inner essay__prose">
        <slot />
      </div>

      <footer class="essay__footer">
        <p class="essay__footer-line">Code changes. Behavior persists.</p>
        <a href="/lab/harness/#cta" class="btn btn--primary btn--ember"
          >Request Early Access</a
        >
      </footer>
    </div>
  </article>

  <Footer />
</Layout>
