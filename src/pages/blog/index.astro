---
import StudioLayout from "../../layouts/StudioLayout.astro";
import ListeArticles from "../../components/studio/ListeArticles.astro";
import { articlesPublies, etiquettesPubliees, libelle } from "../../lib/blog";

const articles = await articlesPublies();
const etiquettes = await etiquettesPubliees();
---
<StudioLayout
  titre="Blog"
  description="Ce qu'on apprend en automatisant des processus chez des PME et des ETI, et ce qu'on construit au lab pour le vérifier."
  actif="">
<section class="hero">
  <div class="wrap prose">
    <p class="eyebrow">Blog</p>
    <h1>Ce qu&rsquo;on apprend en chemin.</h1>
    <p class="lead">Des notes sur l&rsquo;automatisation de processus en PME et ETI&nbsp;: ce qui marche, ce qui ne marche pas, et ce que les chiffres disent une fois qu&rsquo;on les regarde. Les articles du lab portent l&rsquo;étiquette Lab.</p>
    {etiquettes.length > 0 && (
      <nav class="sousnav" aria-label="Étiquettes">
        <a href="/blog/" aria-current="page">Tout</a>
        {etiquettes.map((e) => <a href={`/blog/etiquette/${e}/`}>{libelle(e)}</a>)}
      </nav>
    )}
  </div>
</section>

<section>
  <div class="wrap">
    {articles.length === 0
      ? <p class="muted">Rien de publié pour l&rsquo;instant.</p>
      : <ListeArticles articles={articles} />}
  </div>
</section>
</StudioLayout>
