t-secondary)" stroke-width="2"/></g><rect x="150" y="190" width="180" height="22" rx="4" fill="none" stroke="var(--border)" stroke-width="1" stroke-dasharray="3 3" class="kx-a kx-fade" style="--t:1.18s"/><g class="kx-a kx-droite kx-monte" style="--t:1.18s; --monte:-136px"><rect x="150" y="190" width="180" height="22" rx="4" fill="var(--surface)" stroke="var(--accent)" stroke-width="2"/><line x1="162" y1="201" x2="286" y2="201" stroke="var(--text-secondary)" stroke-width="2"/><text x="304" y="205" font-family="var(--font-code)" font-size="11" fill="var(--accent)">?</text></g><g class="kx-a kx-fade" style="--t:2.10s"><path d="M340 141h26" stroke="var(--accent-bright)" stroke-width="1.5" stroke-dasharray="3 3" fill="none"/><rect x="374" y="130" width="200" height="22" rx="4" fill="var(--surface)" stroke="var(--border)" stroke-width="1"/><line x1="386" y1="141" x2="536" y2="141" stroke="var(--text-secondary)" stroke-width="2"/><circle cx="552" cy="141" r="3.5" fill="var(--accent-bright)"/></g><g class="kx-a kx-fade" style="--t:2.30s"><path d="M340 171h26" stroke="var(--accent-bright)" stroke-width="1.5" stroke-dasharray="3 3" fill="none"/><rect x="374" y="160" width="200" height="22" rx="4" fill="var(--surface)" stroke="var(--border)" stroke-width="1"/><line x1="386" y1="171" x2="536" y2="171" stroke="var(--text-secondary)" stroke-width="2"/><circle cx="552" cy="171" r="3.5" fill="var(--accent-bright)"/></g><text x="374" y="204" font-family="var(--font-code)" font-size="8" fill="var(--text-secondary)" text-anchor="start" letter-spacing="0.12em" class="kx-a kx-fade" style="--t:2.60s">BROUILLON, AVEC SA SOURCE</text><path d="M140 196V78" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 3" class="kx-a kx-fade" style="--t:2.80s"/><g class="kx-a kx-pop" style="--t:3.05s"><rect x="112" y="60" width="20" height="20" rx="4" fill="var(--accent)"/><path d="M117 70l4 4 6-7" fill="none" stroke="var(--bg)" stroke-width="2"/></g><text x="112" y="50" font-family="var(--font-code)" font-size="8" fill="var(--accent)" text-anchor="start" letter-spacing="0.12em" class="kx-a kx-fade" style="--t:3.20s">ARBITRAGE MÉTIER</text></svg></div>
      <div class="d-etroit"><svg xmlns="http://www.w3.org/2000/svg" class="kx" viewBox="0 0 360 512" role="img" aria-label="Le dossier arrive, les questions en sont extraites. Les réponses des dossiers passés viennent s'y attacher avec leur source. La question sans antécédent descend à l'arbitrage." style="display:block;width:100%;height:auto"><title>Réponse à un appel d'offres</title><text x="96" y="62" font-family="var(--font-code)" font-size="11" fill="var(--text-secondary)" text-anchor="start" letter-spacing="0.12em">DOSSIER REÇU</text><g class="kx-a kx-gauche"><path d="M24 30h44l14 14v54H24z" fill="var(--surface)" stroke="var(--accent)" stroke-width="2"/><path d="M68 30v14h14" fill="none" stroke="var(--accent)" stroke-width="2"/></g><text x="24" y="140" font-family="var(--font-code)" font-size="11" fill="var(--accent)" text-anchor="start" letter-spacing="0.12em" class="kx-a kx-fade" style="--t:0.70s">QUESTIONS EXTRAITES</text><g class="kx-a kx-droite" style="--t:0.90s"><rect x="24" y="152" width="312" height="26" rx="4" fill="var(--surface)" stroke="var(--border)" stroke-width="1"/><line x1="36" y1="165" x2="324" y2="165" stroke="var(--text-secondary)" stroke-width="2"/></g><g class="kx-a kx-droite" style="--t:1.04s"><rect x="24" y="188" width="312" height="26" rx="4" fill="var(--surface)" stroke="var(--border)" stroke-width="1"/><line x1="36" y1="201" x2="324" y2="201" stroke="var(--text-secondary)" stroke-width="2"/></g><rect x="24" y="224" width="312" height="26" rx="4" fill="none" stroke="var(--border)" stroke-width="1" stroke-dasharray="3 3" class="kx-a kx-fade" style="--t:1.18s"/><g class="kx-a kx-droite kx-va" style="--t:1.18s;--dx:0px;--dy:236px;--td:3.6s"><rect x="24" y="224" width="312" height="26" rx="4" fill="var(--surface)" stroke="var(--accent)" stroke-width="2"/><line x1="36" y1="237" x2="310" y2="237" stroke="var(--text-secondary)" stroke-width="2"/><text x="318" y="242" font-family="var(--font-code)" font-size="12" fill="var(--accent)">?</text></g><rect x="24" y="272" width="312" height="32" rx="6" fill="none" stroke="var(--border)" stroke-width="2" class="kx-a kx-fade" style="--t:1.60s"/><text x="180" y="292" font-family="var(--font-code)" font-size="10" fill="var(--text-secondary)" text-anchor="middle" letter-spacing="0.12em" class="kx-a kx-fade" style="--t:1.60s">DOSSIERS PASSÉS</text><path d="M320 304V342" fill="none" stroke="var(--accent-bright)" stroke-width="1.5" stroke-dasharray="3 3" class="kx-a kx-fade" style="--t:2.00s"/><text x="24" y="334" font-family="var(--font-code)" font-size="11" fill="var(--accent)" text-anchor="start" letter-spacing="0.12em" class="kx-a kx-fade" style="--t:2.10s">BROUILLON, AVEC SA SOURCE</text><g class="kx-a kx-fade" style="--t:2.30s"><rect x="24" y="348" width="312" height="26" rx="4" fill="var(--surface)" stroke="var(--border)" stroke-width="1"/><line x1="36" y1="361" x2="300" y2="361" stroke="var(--text-secondary)" stroke-width="2"/><circle cx="316" cy="361" r="3.5" fill="var(--accent-bright)"/></g><g class="kx-a kx-fade" style="--t:2.50s"><rect x="24" y="384" width="312" height="26" rx="4" fill="var(--surface)" stroke="var(--border)" stroke-width="1"/><line x1="36" y1="397" x2="300" y2="397" stroke="var(--text-secondary)" stroke-width="2"/><circle cx="316" cy="397" r="3.5" fill="var(--accent-bright)"/></g><g class="kx-a kx-pop" style="--t:3.90s"><rect x="24" y="424" width="20" height="20" rx="4" fill="var(--accent)"/><path d="M29 434l4 4 6-7" fill="none" stroke="var(--bg)" stroke-width="2"/></g><text x="54" y="439" font-family="var(--font-code)" font-size="11" fill="var(--accent)" text-anchor="start" letter-spacing="0.12em" class="kx-a kx-fade" style="--t:4.00s">ARBITRAGE MÉTIER</text></svg></div>
      <figcaption>Chaque question re&ccedil;oit un brouillon issu d&rsquo;un dossier pass&eacute;, avec sa source. Les questions in&eacute;dites sont mises &agrave; part, pour votre arbitrage.</figcaption>
    </figure>
  </div>
</section>

<section>
  <div class="wrap prose">
    <h2>Ce qu'on mesure</h2>
    <ul class="measures">
      <li>Les heures passées par dossier, et par qui</li>
      <li>Le délai de remise</li>
      <li>Le nombre de dossiers traités à effectif constant</li>
    </ul>
    <p style="margin-top:26px">Le gain qui compte n'est pas le temps économisé : c'est le dossier que vous ne laissez plus passer.</p>

    <p class="muted" style="font-size:14px;margin-top:2em">Ce cas est construit à partir de situations observées dans le secteur. Les ordres de grandeur sont des hypothèses jusqu'à ce qu'on les mesure chez vous.</p>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2>Ce cas ressemble au vôtre&nbsp;?</h2>
    <p>45 minutes pour savoir si ce cas-là vous coûte assez pour mériter qu'on s'en occupe. S'il ne le mérite pas, on vous le dira.</p>
    <div class="btn-row">
      <a class="btn" href="/contact">Prendre rendez-vous</a>
      <a class="btn btn-ghost" href="/cas-usages">Voir les autres cas</a>
    </div>
  </div>
</section>
</StudioLayout>
