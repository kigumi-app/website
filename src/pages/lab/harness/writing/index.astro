---
import Layout from "../../../../layouts/Layout.astro";
import Nav from "../../../../components/Nav.astro";
import Footer from "../../../../components/Footer.astro";
import {
  getPublishedEssays,
  PILLAR_LABELS,
  essaySlug,
  formatDate,
} from "../../../../lib/essays";

const essays = await getPublishedEssays();
---

<Layout
  title="Writing - Kigumi"
  description="Essays on the intent gap, behavior infrastructure, and building a category before it has a name."
>
  <Nav active="writing" />

  <section class="writing">
    <div class="container">
      <header class="writing__header">
        <h1 class="writing__title">Writing</h1>
        <p class="writing__dek">
          Notes on the intent gap, behavior infrastructure, and what breaks when
          AI writes most of the code.
        </p>
      </header>

      {
        essays.length === 0 ? (
          <p class="writing__empty">Nothing published yet. Soon.</p>
        ) : (
          <ul class="writing__list">
            {essays.map((essay) => (
              <li>
                <a class="essay-row" href={`/lab/harness/writing/${essaySlug(essay)}`}>
                  <div class="essay-row__meta">
                    <span class="essay-row__pillar">
                      {PILLAR_LABELS[essay.data.pillar]}
                    </span>
                    <span class="essay-row__date">
                      {formatDate(essay.data.pubDate)}
                    </span>
                  </div>
                  <h2 class="essay-row__title">{essay.data.title}</h2>
                  <p class="essay-row__dek">{essay.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <Footer />
</Layout>
