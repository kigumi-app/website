---
import { render } from "astro:content";
import EssayLayout from "../../../../layouts/EssayLayout.astro";
import { getPublishedEssays, essaySlug } from "../../../../lib/essays";

export async function getStaticPaths() {
  const essays = await getPublishedEssays();
  return essays.map((essay) => ({
    params: { slug: essaySlug(essay) },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<EssayLayout essay={essay}>
  <Content />
</EssayLayout>
