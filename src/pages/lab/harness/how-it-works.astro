---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import CutLine from "../../../components/CutLine.astro";
---

<Layout
  title="How Kigumi Works - Import. Reason. Evolve. Verify."
  description="See how Kigumi maps your codebase into a live behavior graph. Import, reason, evolve, verify."
  bodyClass="page-how-it-works"
>
  <Nav active="how-it-works" />

  <section class="page-header">
    <div class="container">
      <a href="/lab/harness/" class="back-link">&larr; Back to Kigumi</a>
      <div class="dimension-label">How it works</div>
      <h1 class="headline headline--section">
        Import. Reason. Evolve.<br />Ship with confidence.
      </h1>
      <p class="subtext">Four steps from codebase to living behavior map.</p>
    </div>
  </section>

  <CutLine />

  <section class="product">
    <div class="container">
      <!-- Step 1: Import -->
      <div class="product-step reveal">
        <div class="product-step__text">
          <div class="dimension-label">
            <span class="step-number">01</span> Import
          </div>
          <h3>
            Point it at your codebase. 847 behaviors. 234 files. 12 minutes.
          </h3>
          <p>
            Kigumi scans your repository and extracts a typed behavior map -
            every state, action, condition, data flow, and event. No
            configuration. No schema files. Just point it at your repo.
          </p>
        </div>
        <div class="fake-ui">
          <div class="fake-ui__bar">
            <div class="fake-ui__dot"></div>
            <div class="fake-ui__dot"></div>
            <div class="fake-ui__dot"></div>
            <span class="fake-ui__bar-title">kigumi - import</span>
          </div>
          <div class="fake-ui__body">
            <div class="scan-progress">
              <div class="scan-progress__header">
                <span class="scan-progress__label">Scanning repository...</span>
                <span class="scan-progress__value">234 / 234 files</span>
              </div>
              <div class="scan-progress__track">
                <div class="scan-progress__fill"></div>
              </div>
            </div>
            <div class="scan-stats">
              <div class="scan-stat">
                <div class="scan-stat__value scan-stat__value--accent">847</div>
                <div class="scan-stat__label">Behaviors extracted</div>
              </div>
              <div class="scan-stat">
                <div class="scan-stat__value scan-stat__value--accent">234</div>
                <div class="scan-stat__label">Files processed</div>
              </div>
              <div class="scan-stat">
                <div class="scan-stat__value">52</div>
                <div class="scan-stat__label">States identified</div>
              </div>
              <div class="scan-stat">
                <div class="scan-stat__value">189</div>
                <div class="scan-stat__label">Actions mapped</div>
              </div>
            </div>
            <div class="scan-files">
              <div>
                <span class="amber">+</span> src/auth/login.ts
                <span class="amber">-- 12 behaviors</span>
              </div>
              <div>
                <span class="amber">+</span> src/api/handlers.ts
                <span class="amber">-- 24 behaviors</span>
              </div>
              <div>
                <span class="amber">+</span> src/store/cart.ts
                <span class="amber">-- 8 behaviors</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: Reason -->
      <div class="product-step reveal">
        <div class="product-step__text">
          <div class="dimension-label">
            <span class="step-number">02</span> Reason
          </div>
          <h3>Every state, action, condition, and data flow. Visible.</h3>
          <p>
            The behavior graph is a typed intermediate representation - not
            documentation, not diagrams, not comments. A living structure that
            shows you how every piece connects.
          </p>
        </div>
        <div class="fake-ui">
          <div class="fake-ui__bar">
            <div class="fake-ui__dot"></div>
            <div class="fake-ui__dot"></div>
            <div class="fake-ui__dot"></div>
            <span class="fake-ui__bar-title">kigumi - behavior graph</span>
          </div>
          <div class="graph-panel__body">
            <svg viewBox="0 0 440 280" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Edges -->
              <line x1="120" y1="60" x2="240" y2="100" stroke="#3a3028" stroke-width="1.5" />
              <line x1="240" y1="100" x2="320" y2="60" stroke="#3a3028" stroke-width="1.5" />
              <line x1="240" y1="100" x2="180" y2="170" stroke="#3a3028" stroke-width="1.5" />
              <line x1="240" y1="100" x2="300" y2="170" stroke="#3a3028" stroke-width="1.5" />
              <line x1="180" y1="170" x2="240" y2="230" stroke="#3a3028" stroke-width="1.5" />
              <line x1="300" y1="170" x2="240" y2="230" stroke="#3a3028" stroke-width="1.5" />

              <!-- State node (Patina) -->
              <rect x="80" y="40" width="80" height="40" rx="8" fill="#1a1410" stroke="#7ab8a0" stroke-width="1.5" />
              <text x="120" y="64" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#7ab8a0">
                Logged Out
              </text>

              <!-- Action node (Amber) -->
              <rect x="200" y="80" width="80" height="40" rx="8" fill="#1a1410" stroke="#d4a054" stroke-width="1.5" />
              <text x="240" y="104" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#d4a054">
                Submit Login
              </text>

              <!-- Condition node (Terracotta) -->
              <rect x="280" y="40" width="80" height="40" rx="8" fill="#1a1410" stroke="#c47a6c" stroke-width="1.5" />
              <text x="320" y="64" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#c47a6c">
                Valid Creds?
              </text>

              <!-- Data node (Heartwood) -->
              <rect x="140" y="150" width="80" height="40" rx="8" fill="#1a1410" stroke="#9a7bb5" stroke-width="1.5" />
              <text x="180" y="174" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#9a7bb5">
                User Token
              </text>

              <!-- Event node (Blueprint) -->
              <rect x="260" y="150" width="80" height="40" rx="8" fill="#1a1410" stroke="#7a9bb8" stroke-width="1.5" />
              <text x="300" y="174" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#7a9bb8">
                Auth Event
              </text>

              <!-- State node 2 (Patina) -->
              <rect x="200" y="210" width="80" height="40" rx="8" fill="#1a1410" stroke="#7ab8a0" stroke-width="1.5" />
              <text x="240" y="234" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#7ab8a0">
                Logged In
              </text>
            </svg>

            <!-- Detail panel -->
            <div class="graph-detail">
              <div class="graph-detail__title">Selected Node</div>
              <div class="graph-detail__name">Submit Login</div>
              <div class="graph-detail__type">Action - Authentication</div>
              <div class="graph-detail__gwt">
                <strong>Given</strong> user is on login form<br />
                <strong>When</strong> credentials submitted<br />
                <strong>Then</strong> validate and authenticate
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3: Evolve -->
      <div class="product-step reveal">
        <div class="product-step__text">
          <div class="dimension-label">
            <span class="step-number">03</span> Evolve
          </div>
          <h3>Describe what you want. Review before it commits.</h3>
          <p>
            Tell Kigumi what to build in natural language. It proposes changes
            to the behavior scheme - staged for your review. Accept, reject, or
            refine. Nothing lands without your approval.
          </p>
        </div>
        <div class="fake-ui">
          <div class="fake-ui__bar">
            <div class="fake-ui__dot"></div>
            <div class="fake-ui__dot"></div>
            <div class="fake-ui__dot"></div>
            <span class="fake-ui__bar-title">kigumi - chat</span>
          </div>
          <div class="fake-ui__body">
            <div class="chat-messages">
              <div class="chat-msg chat-msg--user">
                Add a password reset flow. User enters email, gets a magic link,
                lands on a reset form.
              </div>
              <div class="chat-msg chat-msg--ai">
                I'll add 3 new behaviors: RequestReset (action), ValidateToken
                (condition), and UpdatePassword (action). This connects to your
                existing Auth entity. Staging the changes now.
              </div>
            </div>
            <div class="staging-panel">
              <div class="staging-panel__label">Staged Changes</div>
              <div class="staging-item">
                <span
                  >+ RequestReset
                  <span style="color: var(--text-dim)">(action)</span></span
                >
                <div class="staging-actions">
                  <button class="staging-btn staging-btn--accept">Accept</button>
                  <button class="staging-btn staging-btn--reject">Reject</button>
                </div>
              </div>
              <div class="staging-item">
                <span
                  >+ ValidateToken
                  <span style="color: var(--text-dim)">(condition)</span></span
                >
                <div class="staging-actions">
                  <button class="staging-btn staging-btn--accept">Accept</button>
                  <button class="staging-btn staging-btn--reject">Reject</button>
                </div>
              </div>
              <div class="staging-item">
                <span
                  >+ UpdatePassword
                  <span style="color: var(--text-dim)">(action)</span></span
                >
                <div class="staging-actions">
                  <button class="staging-btn staging-btn--accept">Accept</button>
                  <button class="staging-btn staging-btn--reject">Reject</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 4: Verify -->
      <div class="product-step reveal">
        <div class="product-step__text">
          <div class="dimension-label">
            <span class="step-number">04</span> Verify
          </div>
          <h3>14 of 16 behaviors verified. Automatically.</h3>
          <p>
            Every behavior in the scheme is validated against structural rules,
            completeness checks, and consistency constraints. You know exactly
            where the gaps are - before they become bugs in production.
          </p>
        </div>
        <div class="fake-ui">
          <div class="fake-ui__bar">
            <div class="fake-ui__dot"></div>
            <div class="fake-ui__dot"></div>
            <div class="fake-ui__dot"></div>
            <span class="fake-ui__bar-title">kigumi - verify</span>
          </div>
          <div class="fake-ui__body">
            <div class="verify-score">
              <div class="verify-score__value">14/16</div>
              <div class="verify-score__label">Behaviors Verified</div>
            </div>
            <ul class="verify-list">
              <li class="verify-item">
                <span class="verify-item__icon--pass">&#10003;</span>
                <span>Login flow - all states reachable</span>
              </li>
              <li class="verify-item">
                <span class="verify-item__icon--pass">&#10003;</span>
                <span>Cart checkout - data flows complete</span>
              </li>
              <li class="verify-item">
                <span class="verify-item__icon--pass">&#10003;</span>
                <span>User profile - GWT examples present</span>
              </li>
              <li class="verify-item">
                <span class="verify-item__icon--pass">&#10003;</span>
                <span>Search - condition edges valid</span>
              </li>
              <li class="verify-item">
                <span class="verify-item__icon--fail">&#10007;</span>
                <span>Password reset - missing error state</span>
              </li>
              <li class="verify-item">
                <span class="verify-item__icon--fail">&#10007;</span>
                <span>Notifications - orphaned event node</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CutLine />

  <section class="cta-section">
    <div class="container">
      <h2 class="headline headline--section reveal">
        Import your repo. See what it does.
      </h2>
      <p class="cta-annotation reveal">
        <em>Code changes. Behavior persists.</em>
      </p>
      <div class="reveal" style="margin-top: 20px">
        <a href="/lab/harness/#cta" class="btn btn--primary btn--ember">Request Early Access</a
        >
      </div>
    </div>
  </section>

  <Footer />
</Layout>
