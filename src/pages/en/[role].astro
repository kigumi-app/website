---
// The seven role pages, in English, from the same data.
import PageRole from "../../components/studio/PageRole.astro";
import { catalogue } from "../../lib/cas";

export function getStaticPaths() {
  return catalogue.roles.map((role) => ({ params: { role: role.en.slug }, props: { role } }));
}
---
<PageRole role={Astro.props.role} />
