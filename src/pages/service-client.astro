acity="0.75"/><text x="316" y="270" font-family="var(--font-code)" font-size="10" fill="var(--text-secondary)" text-anchor="end" letter-spacing="0.12em">CAUSE B</text></g><g class="kx-a kx-bas " style="--t:1.82s"><rect x="24" y="328" width="312" height="58" rx="8" fill="var(--surface)" stroke="var(--border)" stroke-width="1"/><rect x="40" y="350" width="14" height="14" rx="3" fill="var(--accent)" opacity="0.75"/><rect x="64" y="350" width="14" height="14" rx="3" fill="var(--accent)" opacity="0.75"/><rect x="88" y="350" width="14" height="14" rx="3" fill="var(--accent)" opacity="0.75"/><text x="316" y="362" font-family="var(--font-code)" font-size="10" fill="var(--text-secondary)" text-anchor="end" letter-spacing="0.12em">CAUSE C</text></g><g class="kx-a kx-fade" style="--t:2.5s"><path d="M154 248l40 28M194 248l-40 28" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="square"/></g><text x="24" y="314" font-family="var(--font-code)" font-size="10" fill="var(--accent)" text-anchor="start" letter-spacing="0.12em" class="kx-a kx-fade" style="--t:2.80s">CAUSE TRAITÉE</text><text x="24" y="422" font-family="var(--font-code)" font-size="11" fill="var(--accent)" text-anchor="start" letter-spacing="0.12em" class="kx-a kx-fade" style="--t:3.60s">LE VOLUME BAISSE</text></svg></div>
