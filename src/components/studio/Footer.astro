        <a href="/industrie-distribution/">Industrie et distribution B2B</a>
        <a href="/service-client/">Éditeurs et services récurrents</a>
      </div>
      <div>
        <h4>Kigumi</h4>
        <a href="/methode/">Notre méthode</a>
        <a href="/travailler-ensemble/">Travailler ensemble</a>
        <a href="/a-propos/">À propos</a>
        {blog && <a href="/blog/">Blog</a>}
        <a href="/lab/">Lab</a>
      </div>
      <div>
        <h4>Confiance</h4>
        <a href="/confiance/">Données et sécurité</a>
        <a href="/confiance/#ai-act">AI Act</a>
