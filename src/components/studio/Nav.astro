---
import { AGENDA } from "../../lib/contact";
// Le groupe « Cas d'usages » se lit depuis les données plutôt que d'être
// recopié : une fiche ou un rôle ajouté s'allume tout seul.
//
// Les entrées sont désignées par leur adresse française, qui sert de clé :
// `lien` en donne l'équivalent anglais. Les pages anglaises passent donc le
// même identifiant `actif` que leur pendant français.
import { catalogue } from "../../lib/cas";
import { lien, ui, type Langue } from "../../lib/i18n";

interface Props {
  actif?: string;
  langue: Langue;
  /** L'adresse de cette page dans l'autre langue (ou un repli). */
  autreLangue: string;
}
const { actif = "", langue, autreLangue } = Astro.props;
const t = ui(langue);
const ENTREES = ["methode", "travailler-ensemble", "cas-usages", "a-propos"] as const;
const GROUPE = new Set([
  ...catalogue.cas.filter((c) => c.niveau === 1).map((c) => c.id),
  ...catalogue.roles.map((r) => r.slug),
]);
const courant = GROUPE.has(actif) ? "cas-usages" : actif;
const autre = langue === "fr" ? "en" : "fr";
---

<header class="site">
  <div class="wrap">
    <a class="lockup" href={lien("/", langue)} aria-label="Kigumi"></a>
    <nav>
      {ENTREES.map((e) => (
        <a href={lien(`/${e}/`, langue)} class={e === courant ? "on" : undefined}>{t.menu[e]}</a>
      ))}
      <a href={AGENDA} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">{t.rdv}</a>
      {/* Le choix est mémorisé : l'accueil ne redirigera plus selon le
          navigateur une fois qu'on a choisi soi-même. */}
      <a class="langue" href={autreLangue} hreflang={autre} lang={autre} data-langue={autre}
         aria-label={t.autreLangue.libelle}>{t.autreLangue.code}</a>
      <button type="button" class="modetoggle" id="modetoggle"
              aria-label={t.versClair} aria-pressed="false"
              data-vers-clair={t.versClair} data-vers-sombre={t.versSombre}>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
      </button>
    </nav>
  </div>
</header>
<script is:inline>
  document.querySelectorAll("a[data-langue]").forEach(function (a) {
    a.addEventListener("click", function () {
      document.cookie = "langue=" + a.getAttribute("data-langue")
        + "; path=/; max-age=31536000; SameSite=Lax; Secure";
    });
  });
</script>
