---
// Les fiches d'une page de rôle. Celles de niveau 1 renvoient vers leur page
// détaillée ; celles de niveau 2 se lisent entièrement ici.
import { parId } from "../../lib/cas";
const { ids } = Astro.props;
const fiches = ids.map((i: string) => parId.get(i)!);
---
<ul class="fiches">
  {fiches.map((c) => (
    <li id={`cas-${c.id}`}>
      <p class="who">{c.public}</p>
      <h3>{c.titre}</h3>
      <p>{c.accroche}</p>
      <p>{c.mecanisme}</p>
      {c.niveau === 1 && (
        <p><a href={`/${c.id}`}>Voir la fiche détaillée &rarr;</a></p>
      )}
      <div class="mesure">
        <span>Ce qu&rsquo;on mesure</span>
        <ul>{c.mesure.map((m: string) => <li>{m}</li>)}</ul>
      </div>
    </li>
  ))}
</ul>
