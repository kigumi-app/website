---
import LogoMark from "../LogoMark.astro";
---

<section class="hero">
  <div class="container">
    <div class="label hero__label">For technical founders and CTOs</div>
    <h1 class="headline headline--hero">
      AI made code cheap.<br />
      <LogoMark
        width={70}
        height={70}
        fill="#d4a054"
        class="logo-mark hero__logo-mark"
      />igumi makes <span class="accent">change</span> safe.
    </h1>
    <p class="subtext" style="margin: 28px auto 44px">
      See what your codebase actually does. Every state, action, and decision -
      visible.
    </p>
    <div class="hero__actions">
      <a href="/lab/harness/#cta" class="btn btn--primary btn--ember">Request Early Access</a
      >
      <a href="/lab/harness/how-it-works" class="btn btn--ghost">How it works</a>
    </div>
  </div>
  <span class="margin-note" style="right: 40px; top: 220px" aria-hidden="true"
    >rev. 04</span
  >
</section>
