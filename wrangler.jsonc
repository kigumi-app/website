// Déploiement Cloudflare Workers — site statique, aucun code serveur.
//
// Workers Builds lance `npm run build`, puis `npx wrangler deploy` sur main et
// `npx wrangler versions upload` sur les autres branches (prévisualisations).
// `_redirects` et `404.html` sont lus depuis dist/, comme sur Pages.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kigumi-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "preview_urls": true
}
